 // Refresh cadence and source observation validity are separate clocks.
 const OFFICIAL_CAPTURE_MAX_AGE_MS=36*3600000;
 const TWSE_STATISTICS_KEY='official-taiwan-statistics:v1';
+const TAIWAN_CREDIT_FIELDS=[
+  ['TWSE_MARGIN_BALANCE_NTD','融資餘額','億元'],
+  ['TWSE_MARGIN_CHANGE_NTD','融資餘額日增減','億元'],
+  ['TWSE_MARGIN_BALANCE_UNITS','融資餘額','張'],
+  ['TWSE_SHORT_BALANCE','融券餘額','張'],
+  ['TWSE_SHORT_CHANGE','融券餘額日增減','張'],
+  ['TWSE_MARGIN_MARKET_CAP_RATIO','融資餘額占市值比','%'],
+  ['TWSE_CREDIT_TRADE_VALUE','信用交易成交值','億元'],
+];
+function taiwanCreditCaptureAllowed(now=Date.now()) {
+  const local=new Date(now+8*3600000);
+  return local.getUTCHours()*60+local.getUTCMinutes()>=22*60+30;
+}
+async function retainedTaiwanCreditRows(env,now=Date.now()) {
+  const snapshots=await Promise.all(['macro-market:v7','macro:v1'].map(key=>readRuntimeCache(env,key)));
+  const ids=new Set(TAIWAN_CREDIT_FIELDS.map(([id])=>id));
+  const candidates=snapshots.flatMap(saved=>(saved?.payload?.rows||[]).filter(row=>ids.has(row.id)).map(row=>({row,checkedAt:saved.payload.checkedAt})));
+  // An expired import can still supply historical evidence. Validate it at its
+  // original capture time, then apply the current freshness clock below.
+  const imported=await readRuntimeCache(env,TWSE_STATISTICS_KEY);
+  if(imported?.payload){
+    const captured=Date.parse(imported.payload.capturedAt||'');
+    if(Number.isFinite(captured)&&captured<=now)try{
+      const rows=validateTaiwanStatistics(imported.payload,captured);
+      candidates.push(...rows.filter(row=>ids.has(row.id)).map(row=>({row,checkedAt:imported.payload.capturedAt})));
+    }catch{}
+  }
+  const localDate=new Date(now+8*3600000).toISOString().slice(0,10);
+  return TAIWAN_CREDIT_FIELDS.map(([id,name,unit])=>{
+    const valid=candidates.filter(({row,checkedAt})=>{
+      const stamp=Date.parse(row.verifiedAt||row.fetchedAt||checkedAt||'');
+      if(row.id!==id||!['ok','snapshot','stale'].includes(row.status)||!Number.isFinite(row.value)||!officialImportDate(row.date)||row.date>localDate||!Number.isFinite(stamp)||stamp>now)return false;
+      try{const source=new URL(row.source);return source.protocol==='https:'&&!source.username&&!source.password&&!source.port&&['www.twse.com.tw','openapi.twse.com.tw'].includes(source.hostname);}catch{return false;}
+    }).sort((a,b)=>b.row.date.localeCompare(a.row.date)||Date.parse(b.row.verifiedAt||b.row.fetchedAt||b.checkedAt)-Date.parse(a.row.verifiedAt||a.row.fetchedAt||a.checkedAt));
+    const selected=valid[0],deferred={captureDeferred:true,capturePolicy:'after_2230_taipei',capturePolicyReason:'台北時間22:30前不重抓信用統計；保留原觀測日及原核對時間。'};
+    if(!selected)return {id,name,unit,group:'台股市場',value:null,date:null,status:'missing',is_stale:false,reason:'22:30前未抓取信用統計，且沒有可核對的既有觀測。',...deferred};
+    const {row,checkedAt}=selected,stamp=row.verifiedAt||row.fetchedAt||checkedAt;
+    const candidate={...row,verifiedAt:stamp,status:row.snapshot?'snapshot':'ok',is_stale:false};
+    const current=row.status!=='stale'&&!row.is_stale&&macroObservationCurrent(candidate,{checkedAt,rows:[candidate]},now);
+    return {...row,verifiedAt:stamp,status:current?'snapshot':'stale',snapshot:true,is_stale:!current,
+      reason:current?row.reason||null:'既有信用觀測已過有效期；22:30後再抓取核對。',...deferred};
+  });
+}
 function officialFredSeriesId(id){return {US3M:'DTB3',US10Y:'DGS10',US30Y:'DGS30'}[id]||id}
 function recentOfficialCapture(value,now=Date.now()) {
   const stamp=Date.parse(value);return Number.isFinite(stamp)&&stamp<=now+60000&&now-stamp<OFFICIAL_CAPTURE_MAX_AGE_MS;
