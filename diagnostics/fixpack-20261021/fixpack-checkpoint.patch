-top:10px}.financial-source-item{min-width:0;background:var(--panel2);border:1px solid #213b55;border-radius:12px;padding:11px}.financial-source-item b{display:block;font-size:.85rem}.financial-source-item span,.financial-source-item small{display:block;color:var(--muted);font-size:.75rem;line-height:1.5;margin-top:4px;overflow-wrap:anywhere}@media(max-width:560px){.financial-source-grid{grid-template-columns:1fr}}</style>\n<style>\n  /* US_SECTOR_DISPLAY_STYLE_START */\n  .us-sector-table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:.82rem}.us-sector-table caption{text-align:left;color:var(--muted);padding:8px 0;line-height:1.5}.us-sector-table th,.us-sector-table td{padding:10px 4px;border-bottom:1px solid var(--line);text-align:right;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.us-sector-table th:first-child{width:40%;text-align:left}.us-sector-table thead th{color:#9fb5c8;font-weight:600}.us-sector-table tbody th{font-weight:500}.us-sector-table strong,.us-sector-table small{display:block}.us-sector-table small{margin-top:4px;font-size:.7rem;color:var(--muted)}.us-sector-table td{width:20%}.us-sector-table .sector-unknown{font-size:.7rem;color:var(--muted)}.us-sector-note{overflow-wrap:anywhere}.us-sector-note a{color:#8dbef8}@media(max-width:560px){.us-sector-table{font-size:.76rem}.us-sector-table th,.us-sector-table td{padding:9px 3px}.us-sector-table .sector-unknown{font-size:.6rem}}\n  /* US_SECTOR_DISPLAY_STYLE_END */\n  .cloud-sync-notice{margin-top:10px;padding:10px 12px;border:1px solid #806637;border-radius:10px;color:#ffdc91;font-size:.8rem;line-height:1.6}.cloud-sync-notice[hidden]{display:none}.cloud-sync-notice a,#automaticSourceRecords a{color:#8dbef8}#automaticSourcePanel{margin-top:12px}#automaticSourcePanel>summary{cursor:pointer;color:#c5d9eb}.tiny,.gate p,.source-box small{overflow-wrap:anywhere}.stat b{overflow-wrap:anywhere}.panel,.workspace>*{min-width:0}.pipeline form input:not([type=\"checkbox\"]):not([type=\"file\"]),.pipeline form textarea{width:100%;min-width:0;background:#081522;border:1px solid #29435c;border-radius:8px;color:var(--text);padding:9px;font:inherit}.pipeline form label{min-width:0;font-size:.8rem;color:var(--muted)}.pipeline form textarea{resize:vertical}.pipeline form button{font:inherit;background:#13283a;border:1px solid #31506a;color:var(--text);border-radius:8px;padding:8px 10px}.stock-select:focus-visible,.stock-remove:focus-visible,summary:focus-visible{outline:2px solid var(--green);outline-offset:4px}\n  @media(max-width:560px){.stock-card{flex:0 0 78vw;max-width:330px;scroll-snap-align:start}.gate-top,.quality-head{flex-wrap:wrap}.gate .badge{white-space:normal}.pipeline-head{display:block}.matrix{grid-template-columns:1fr 1fr}}\n</style>\n<!-- ADVISORY_PANEL_STYLE_START -->\n<style>\n.advisory-panels{margin:16px 0;padding:16px;border:1px solid var(--line);border-radius:14px;background:var(--panel2)}.advisory-panels[hidden]{display:none}.advisory-panels h4{margin:0 0 10px}.advisory-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}.advisory-card{min-width:0;background:var(--panel);border:1px solid var(--line);padding:12px;border-radius:10px}.advisory-card p{font-size:.85rem;line-height:1.7;overflow-wrap:anywhere}.advisory-card small{display:block;color:var(--muted);font-size:.72rem;line-height:1.7;overflow-wrap:anywhere}.advisory-axis{position:relative;height:45px;margin:18px 12px 22px;border-bottom:1px solid var(--line)}.advisory-axis-tick{position:absolute;top:0;height:45px;border-left:1px solid var(--line);font-size:9px;color:var(--muted)}.advisory-axis-tick.reference{border-color:#8fa5b8;padding-top:45px}.advisory-axis-bar{position:absolute;top:12px;height:17px;opacity:.75}.advisory-decision{margin-top:14px;padding:12px;border:1px solid #806637;border-radius:10px}.advisory-decision ul{padding-left:20px}.advisory-decision p{overflow-wrap:anywhere}@media(max-width:560px){.advisory-grid{grid-template-columns:1fr}.advisory-panels{padding:12px}}\n</style>\n<!-- ADVISORY_PANEL_STYLE_END -->\n</head>\n<body>\n<main class=\"wrap\">\n  <header class=\"top\">\n    <div class=\"brand\"><div class=\"logo\"><svg viewBox=\"0 0 40 40\" aria-hidden=\"true\"><path d=\"M4 30l9-10 7 6L35 8\" fill=\"none\" stroke=\"#35e5a1\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><div><h1>台股 Master Model</h1><p>資料、計算與判斷分離</p></div></div>\n    <div class=\"stamp\"><b>資料觀測日</b><br>逐模組標示｜不代表同日</div>\n  </header>\n\n  <section class=\"summary\">\n    <div class=\"hero\"><span class=\"eyebrow\" id=\"watchlistCount\">追蹤清單</span><strong>完整 Master Model：待驗證</strong><small>技術訊號不是買進許可；總經、產業與法說缺值時不升級風險預算。</small></div>\n    <div class=\"stat\"><span>目前選取</span><b id=\"selectedOverview\">等待個股</b></div>\n    <div class=\"stat\"><span>個股資料狀態</span><b id=\"stockOverviewStatus\">讀取中</b></div>\n    <div class=\"stat\"><span>估值計算日（台灣）</span><b id=\"valuationToday\" style=\"color:var(--yellow)\">讀取中</b></div>\n  </section>\n\n  <section class=\"panel macro\" aria-labelledby=\"macroTitle\">\n    <div class=\"panel-title\"><h3 id=\"macroTitle\">純總經監測｜五行摘要</h3><button class=\"refresh\" id=\"macroRefresh\" type=\"button\">立即更新</button></div>\n    <p class=\"macro-meta\" id=\"macroMeta\">頁面開啟時自動查詢；前景每 15 分鐘更新一次。各指標保留自己的觀測日與來源。</p>\n    <p class=\"macro-meta\" id=\"siteAutomationMeta\">整站後台自動巡檢：等待排程狀態。</p>\n    <details class=\"dimension-details\" id=\"siteAutomationDetails\"><summary>每日資料巡檢與尚未接入項目</summary><button type=\"button\" id=\"siteRefreshAll\" style=\"margin:8px 0 12px;padding:8px 12px;border:1px solid #31506a;background:#13283a;color:var(--text);border-radius:10px;cursor:pointer\">立即巡檢全站</button><div id=\"siteAutomationReport\" class=\"macro-meta\">等待後台巡檢紀錄。</div></details>\n    <h4 class=\"macro-label\">美國主要股指</h4>\n    <p class=\"macro-meta\" id=\"usIndexMeta\">美股指數獨立查詢中…</p>\n    <div class=\"market-grid\" id=\"usIndices\" aria-live=\"polite\">\n      <div class=\"macro-item\"><span>標普 500</span><b>正在更新</b><small>FRED 日資料｜等待觀測值</small></div>\n      <div class=\"macro-item\"><span>道瓊工業指數</span><b>正在更新</b><small>FRED 日資料｜等待觀測值</small></div>\n      <div class=\"macro-item\"><span>那斯達克綜合指數</span><b>正在更新</b><small>FRED 日資料｜等待觀測值</small></div>\n    </div>\n    <!-- US_SECTOR_DISPLAY_START -->\n    <section id=\"usSectorSection\" aria-labelledby=\"usSectorTitle\">\n      <h4 class=\"macro-label\" id=\"usSectorTitle\">美股 11 大板塊｜相對 SPY 強弱</h4>\n      <p class=\"macro-meta\" id=\"usSectorMeta\" role=\"status\">板塊資料獨立載入中；不必等待個股報告。</p>\n      <p class=\"tiny\" id=\"usSectorBenchmark\">SPY 5D／10D／20D 價格報酬：UNKNOWN。</p>\n      <table class=\"us-sector-table\" aria-describedby=\"usSectorMethod\"><caption>相對 SPY 的價格報酬差｜單位：個百分點</caption><thead><tr><th scope=\"col\">板塊／ETF</th><th scope=\"col\">5D</th><th scope=\"col\">10D</th><th scope=\"col\">20D</th></tr></thead><tbody id=\"usSectorRows\">\n        <tr><th scope=\"row\">資訊科技<small>XLK</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">通訊服務<small>XLC</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">非必需消費<small>XLY</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">必需消費<small>XLP</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">金融<small>XLF</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">工業<small>XLI</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">醫療保健<small>XLV</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">能源<small>XLE</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">原物料<small>XLB</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">公用事業<small>XLU</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n        <tr><th scope=\"row\">房地產<small>XLRE</small></th><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td><td class=\"sector-unknown\">UNKNOWN</td></tr>\n      </tbody></table>\n      <p class=\"macro-meta us-sector-note\" id=\"usSectorMethod\">正值＝領先 SPY，負值＝落後 SPY。本表採美股最新已完成收盤；個股報告另與台股基準日對齊。ETF 價格輪動不等同成分股廣度或資金流；不增加評分或解除 VETO。來源：<a href=\"https://raw.githubusercontent.com/wcr0936531039-png/macro-relay-service/main/data/us_sector_history.json\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub 歷史資料池</a>（Yahoo Finance 非官方資料）。</p>\n    </section>\n    <!-- US_SECTOR_DISPLAY_END -->\n    <h4 class=\"macro-label\">其他市場與風險指標</h4>\n    <p class=\"macro-meta\" id=\"marketMeta\">市場資料獨立載入；來源缺漏會保留灰色資料卡。</p>\n    <div class=\"market-grid\" id=\"marketIndicators\" aria-live=\"polite\">\n      <div class=\"macro-item\"><span>黃金參考報價</span><b>正在更新</b><small>等待資料來源</small></div>\n      <div class=\"macro-item\"><span>發行量加權股價指數</span><b>正在更新</b><small>證交所盤後資料</small></div>\n      <div class=\"macro-item\"><span>集中市場成交值</span><b>正在更新</b><small>證交所盤後資料</small></div>\n      <div class=\"macro-item\"><span>WTI 原油現貨</span><b>正在更新</b><small>等待資料來源</small></div>\n      <div class=\"macro-item\"><span>10 年實質殖利率</span><b>正在更新</b><small>FRED 日資料</small></div>\n      <div class=\"macro-item\"><span>高收益債利差</span><b>正在更新</b><small>FRED 日資料</small></div>\n    </div>\n    <h4 class=\"macro-label\">由原始資料計算</h4><div class=\"macro-grid\" id=\"macroDerived\">\n      <div class=\"macro-item\"><span>SOFR−IORB（同日）</span><b>等待資料</b><small>以兩項同日利率計算</small></div>\n      <div class=\"macro-item\"><span>核心 CPI 3 個月年化</span><b>等待資料</b><small>以季調指數計算</small></div>\n      <div class=\"macro-item\"><span>核心 PCE 3 個月年化</span><b>等待資料</b><small>以季調指數計算</small></div>\n      <div class=\"macro-item\"><span>初領失業金 4 週平均</span><b>等待資料</b><small>最近連續四週平均</small></div>\n    </div>\n    <ol class=\"macro-summary\" id=\"macroFive\"><li>載入中；可用資料逐項呈現，缺值不推定安全。</li></ol>\n    <p class=\"macro-meta\" id=\"expandedMacroMeta\">勞動與需求月資料獨立查詢中…</p>\n    <details class=\"dimension-details\"><summary>五大監測維度｜已接入與待補</summary>\n      <p class=\"macro-meta\">先看資料與訊號，再決定風險預算；不以單一加權分數或單一門檻直接定多空。缺資料維持灰色，不代表安全。</p>\n      <div class=\"dimension-grid\" id=\"macroDimensions\" aria-live=\"polite\"></div>\n    </details>\n    <details><summary>全部指標、日期、來源與未接入項目</summary><div class=\"macro-grid\" id=\"macroIndicators\"></div><p class=\"macro-meta\" id=\"macroCaveat\"></p></details>\n    <details class=\"audit-details\"><summary>官方新聞／公告交叉核對</summary>\n      <p class=\"audit-intro\">先確認觀測月份與資料狀態，再看公式重算與跨指標差異。這裡的「重算一致」只檢查網站公式與輸入值，不等於獨立來源已證實，也不直接產生交易燈號。</p>\n      <h4 class=\"audit-section-title\">資料日期與狀態</h4><div class=\"audit-grid\" id=\"auditFreshness\"><div class=\"audit-card\">等待總經資料</div></div>\n      <h4 class=\"audit-section-title\">公式重算</h4><div class=\"audit-grid\" id=\"auditFormulas\"><div class=\"audit-card\">等待可用觀測值</div></div>\n      <h4 class=\"audit-section-title\">多維比較</h4><div class=\"compare-grid\" id=\"macroComparisons\"><div class=\"compare-card\">等待可比較資料</div></div>\n      <h4 class=\"audit-section-title\">官方來源</h4><div class=\"audit-links\"><a href=\"https://www.bls.gov/news.release/cpi.nr0.htm\" target=\"_blank\" rel=\"noopener noreferrer\">BLS CPI 最新新聞稿</a><a href=\"https://data.bls.gov/timeseries/CUSR0000SA0L1E\" target=\"_blank\" rel=\"noopener noreferrer\">BLS 核心 CPI 季調序列</a><a href=\"https://www.bea.gov/data/income-saving/personal-income\" target=\"_blank\" rel=\"noopener noreferrer\">BEA 個人所得與 PCE</a><a href=\"https://oui.doleta.gov/unemploy/claims.asp\" target=\"_blank\" rel=\"noopener noreferrer\">勞工部 ETA 失業金週報</a><a href=\"https://home.treasury.gov/treasury-daily-interest-rate-xml-feed\" target=\"_blank\" rel=\"noopener noreferrer\">美國財政部每日殖利率 XML</a><a href=\"https://fred.stlouisfed.org/series/SAHMREALTIME\" target=\"_blank\" rel=\"noopener noreferrer\">FRED Sahm Rule</a></div>\n      <p class=\"macro-meta\" id=\"newsMeta\">正在查詢官方公告索引…</p><div class=\"news-grid\" id=\"newsGrid\"></div>\n    </details>\n    <section class=\"macro-score-section\" aria-labelledby=\"macroScoreTitle\">\n      <div class=\"score-head\"><div><h3 id=\"macroScoreTitle\">總經位階評分｜台股與美股</h3><p class=\"macro-meta\">分數代表目前可核實訊號對股票環境的支持度（0–100），不是上漲機率、報酬預測或買賣指令。</p></div><span id=\"macroScoreAsOf\" class=\"score-asof\">等待資料</span></div>\n      <div class=\"macro-score-grid\" id=\"macroScorecards\" aria-live=\"polite\">\n        <article class=\"score-card score-incomplete\"><div class=\"score-card-head\"><div><span class=\"score-kicker\">美股總經環境</span><h4>灰燈｜等待資料</h4></div><strong>—<small>/100</small></strong></div><p class=\"score-coverage\">資料覆蓋率：計算中</p><p class=\"score-note\">資料載入完成後依最新有效觀測計算。</p></article>\n        <article class=\"score-card score-incomplete\"><div class=\"score-card-head\"><div><span class=\"score-kicker\">台股總經與市場位階</span><h4>灰燈｜等待資料</h4></div><strong>—<small>/100</small></strong></div><p class=\"score-coverage\">資料覆蓋率：計算中</p><p class=\"score-note\">資料載入完成後依最新有效觀測計算。</p></article>\n      </div>\n      <p class=\"score-method\">評分採固定維度權重；資料缺漏不以 0 或中性值填補，分數只用可用維度計算並同時揭露資料覆蓋率。覆蓋不足或關鍵維度缺值時顯示灰燈；綠／黃／橘／紅分數帶分別為 70–100、55–69、40–54、0–39。單日市場廣度與漲跌只作短線確認，不能單獨形成趨勢結論。</p>\n    </section>\n  </section>\n\n  <section class=\"panel stock-search\" aria-labelledby=\"stockSearchTitle\">\n    <h3 id=\"stockSearchTitle\">個股搜尋與追蹤清單</h3>\n    <form id=\"stockSearchForm\" class=\"stock-search-row\"><input id=\"stockSearchInput\" type=\"search\" autocomplete=\"off\" maxlength=\"32\" placeholder=\"輸入台股／上櫃名稱或代號，例如：台積電、2330\" aria-label=\"搜尋台灣上市或上櫃股票\"><button id=\"stockSearchButton\" type=\"submit\">搜尋個股</button></form>\n    <div id=\"stockSearchResults\" class=\"stock-results\" aria-live=\"polite\"></div>\n    <p class=\"stock-search-note\">範圍：台灣上市、上櫃一般股票。資料來源中斷、未掛牌或無該項歷史資料時會標示缺項。</p>\n    <p class=\"stock-search-note\" id=\"watchlistSyncStatus\" aria-live=\"polite\">追蹤清單已保存在此瀏覽器；正在核對雲端同步。</p>\n    <div id=\"cloudSyncNotice\" class=\"cloud-sync-notice\" role=\"status\" hidden><span id=\"cloudSyncMessage\"></span> <a id=\"cloudSyncSignIn\" href=\"/signin-with-chatgpt?return_to=%2F\" target=\"_top\" hidden>重新登入 ChatGPT</a></div>\n  </section>\n\n  <section class=\"panel source-panel\" aria-labelledby=\"sourceTitle\">\n    <div class=\"panel-title\"><h3 id=\"sourceTitle\">個股財經資料｜群聯 8299</h3><button class=\"refresh\" id=\"stockRefresh\" type=\"button\">核對個股資料</button></div>\n    <div class=\"source-grid\">\n      <div class=\"source-box\"><span>個股收盤價</span><b id=\"livePrice\">查詢中</b><small id=\"livePriceMeta\">依來源觀測日顯示</small></div>\n      <div class=\"source-box\"><span>FinMind 月營收</span><b id=\"liveRevenue\">查詢中</b><small id=\"liveRevenueMeta\">以營收月份為準</small></div>\n      <div class=\"source-box\"><span>歷史獲利情境估值</span><b id=\"valuationSummary\">載入後更新</b><small id=\"valuationSummaryMeta\">舊手動假設不再當成即時估值。</small></div>\n    </div>\n    <p class=\"macro-meta\" id=\"stockSourceMeta\">正在向台股財經資料服務查詢；若無法連線，顯示缺值，不沿用快照冒充新資料。</p>\n    <p class=\"tiny\" id=\"automaticSourceStatus\" aria-live=\"polite\">選取股票後依代號抓取並保存。</p>\n    <details id=\"automaticSourcePanel\"><summary id=\"automaticSourceTitle\">自動資料池｜公司公告與產業報告</summary><div id=\"automaticSourceRecords\"></div></details>\n    <div class=\"source-links\"><a href=\"https://finmind.github.io/tutor/TaiwanMarket/Fundamental/\" target=\"_blank\" rel=\"noopener noreferrer\">FinMind 資料定義</a><a href=\"https://openapi.twse.com.tw/\" target=\"_blank\" rel=\"noopener noreferrer\">證交所原始資料</a><a href=\"https://www.tpex.org.tw/openapi/\" target=\"_blank\" rel=\"noopener noreferrer\">櫃買中心原始資料</a><a href=\"https://goodinfo.tw/tw/index.asp\" target=\"_blank\" rel=\"noopener noreferrer\">Goodinfo 核對</a><a href=\"https://statementdog.com/\" target=\"_blank\" rel=\"noopener noreferrer\">財報狗核對</a><a id=\"consensusReference\" href=\"https://www.marketscreener.com/search/\" target=\"_blank\" rel=\"noopener noreferrer\">分析師預估參考（MarketScreener）</a><a href=\"https://www.alphamemo.ai/free-transcripts\" target=\"_blank\" rel=\"noopener noreferrer\">法說逐字稿人工查閱（AlphaMemo）</a></div>\n    <p class=\"tiny\">切換股票會自動更新財報、公司重大訊息與已接入的產業研究來源。報告依原始發布日期保存；共識、指引回測與直接同業仍逐項驗證，不用模型 EPS 補值。</p>\n  </section>\n\n  <section class=\"panel valuation-top\" id=\"valuationCalculator\">\n    <div class=\"panel-title\"><h3>今年 EPS × 歷史 P/E｜折現股價</h3><small id=\"calcStock\">等待同步財報、營收與本益比</small></div>\n    <div class=\"value-band\" id=\"scenarioValues\"></div>\n    <p class=\"note\" id=\"historicalScenarioReference\">歷史 P/E 分位乘上今年模型預估 EPS，列出年末估值及折現回目前估值日的現值。</p>\n    <div class=\"calc-verdict\" id=\"calcVerdict\"></div>\n    <p class=\"note\" id=\"valuationBasis\">今年預估 EPS 以已公告季度 EPS 加上過去完整年度同季 EPS 樣本推估；依同期營收年增倍率調整，再用市場歷史 P/E 分位計算年末股價。8%／10%／12% 是股權折現率敏感度假設，不是公司專屬 WACC 或分析師共識。</p>\n  </section>\n\n  <section class=\"stock-grid\" id=\"stockGrid\"></section>\n\n  <section class=\"workspace\">\n    <div class=\"panel\">\n      <h3 id=\"detailTitle\">群聯 8299｜Master Model</h3>\n      <div class=\"matrix\" id=\"metrics\"></div>\n      <div class=\"quality\" id=\"quality\"></div>\n    </div>\n    <aside class=\"panel\">\n      <h3>財務品質判讀標準</h3>\n      <div class=\"standard\"><div class=\"standard-head\"><h4>ROIC｜投入資本報酬率</h4><span class=\"badge good\">應高於 WACC</span></div><div class=\"scale\"><i class=\"r\"></i><i class=\"y\"></i><i class=\"b\"></i><i class=\"g\"></i></div><div class=\"scale-labels\"><span>&lt;8% 弱</span><span>8–12% 觀察</span><span>12–20% 良好</span><span>&gt;20% 強</span></div><p>核心不是只看絕對值，而是 ROIC 是否長期高於資金成本 WACC；高出 3 個百分點以上才較有經濟價值。景氣股需用 3–5 年常態值，不能只看單季年化。</p></div>\n      <div class=\"standard\"><div class=\"standard-head\"><h4>CFO／Net Income｜獲利含金量</h4><span class=\"badge fair\">看 3 年累計</span></div><div class=\"scale\"><i class=\"r\"></i><i class=\"y\"></i><i class=\"b\"></i><i class=\"g\"></i></div><div class=\"scale-labels\"><span>&lt;0 警訊</span><span>0–0.8 偏弱</span><span>0.8–1.2 正常</span><span>&gt;1.2 強</span></div><p>長期接近或高於 1，代表淨利能轉成營業現金。單期大於 2 可能只是存貨、應收帳款釋放，不一定可持續；負值通常需檢查庫存與應收帳款。</p></div>\n      <p class=\"note\">個股切換時重新讀取該公司的季度財報。ROIC 顯示近四季估算並附分母及期別；CFO／淨利使用近三年同期間資料，先將現金流量表年度累計值還原為單季。缺必要欄位時列出原因，不沿用其他股票或舊快照。</p>\n    </aside>\n  </section>\n  <section class=\"panel\" id=\"financialAnalysisPanel\" style=\"margin-top:14px\">\n    <div class=\"panel-title\"><h3>個股財報資料來源｜讀取與輸出</h3><button id=\"refreshFinancialSource\" type=\"button\">重新讀取個股資料</button></div>\n    <p class=\"tiny\">此區只依目前選取的個股讀取行情、月營收與季度財報，顯示來源、觀測期及資料欄位；不在此做總經或投資判讀。輸出的同一份後端快照供下方網站 Master Model 使用。</p>\n    <p id=\"financialSourceStatus\" class=\"tiny\">選取個股後自動讀取；此處顯示資料來源與觀測期。</p>\n    <div id=\"financialSourceOutput\" class=\"financial-source-grid\" aria-live=\"polite\"></div>\n    <section class=\"overall-report\" id=\"financialReportOutput\" aria-live=\"polite\" style=\"margin-top:14px\">\n      <div class=\"overall-report-head\"><h4 id=\"financialReportTitle\">財報解讀｜讀取官方財報</h4><span class=\"badge muted-status\" id=\"financialReportStatus\">等待執行</span></div>\n      <button class=\"refresh\" id=\"refreshFinancialReport\" type=\"button\">讀取財報並分析</button>\n      <p id=\"financialReportHeadline\" class=\"tiny\">按下後直接使用網站已讀取的個股財報與營收資料整理報告，並列出資料日期與來源；不含總經判讀，也不會改動 Master Model Gate。</p>\n      <p id=\"financialReportMeta\" class=\"tiny\">財報資料載入後可執行；每份分析保留使用的快照日期、財報期別、PDF 讀取狀態與來源。</p>\n      <div id=\"financialReportBody\" class=\"overall-report-grid\" style=\"margin-top:10px\"></div>\n      <div id=\"financialReportSources\" class=\"tiny\" style=\"margin-top:8px\"></div>\n    </section>\n  </section>\n  <section class=\"panel pipeline\" aria-labelledby=\"pipelineTitle\">\n    <div class=\"pipeline-head\"><h3 id=\"pipelineTitle\">Master Model｜評級與核驗狀態</h3><p>灰色＝缺少可驗證資料；黃燈＝已有訊號、仍待確認</p></div>\n    <p class=\"tiny\" id=\"masterModelStatus\" role=\"status\" aria-live=\"polite\">等待個股資料完成後更新決策鏈。</p>\n    <div class=\"guardrail\" id=\"overallGate\">關鍵上游資料尚未接入：完整評級暫停，不得以技術 PASS 取代 Macro／Quality Gate。</div>\n    <section class=\"overall-report\" id=\"qualifiedReport\" hidden aria-live=\"polite\">\n      <div class=\"overall-report-head\"><h4 id=\"qualifiedTitle\">退避風險評級</h4><span id=\"qualifiedStatus\" class=\"badge watch\">使用已核驗資料與替代規則</span></div>\n      <p id=\"qualifiedGrade\" style=\"font-size:1.4rem;font-weight:700\"></p>\n      <p id=\"qualifiedPolicyNotice\" class=\"tiny\"></p>\n      <p id=\"qualifiedBasis\"></p>\n      <p id=\"qualifiedConclusion\"></p><p id=\"qualifiedConsensus\"></p>\n      <details id=\"qualifiedLimitDetails\" data-view-key=\"qualified-limits\"><summary>評級規則、降級與風險原因</summary><div id=\"qualifiedLimits\" class=\"tiny\"></div></details>\n    </section>\n\n    <details class=\"panel\" style=\"margin:12px 0;padding:14px\"><summary><strong>2026／2027 EPS｜自動連結個股資料池與總經</strong></summary><div id=\"autoEstimateLink\" class=\"tiny\" aria-live=\"polite\">選取個股後自動載入個股 EPS、資料池候選與總經快照。</div><details style=\"margin-top:12px\"><summary><strong>人工補登 CSV（只補資料池沒有的來源）</strong></summary><p class=\"tiny\">CSV 欄位：ticker,year,eps_low,eps_mid,eps_high,analysts_count,update_date,source,source_url,estimate_type。補登紀錄不會自動變成市場共識；仍須符合來源與授權門檻。</p><form id=\"estimateImportForm\" style=\"display:grid;gap:8px;margin:10px 0\"><label>貼上 CSV 資料<textarea name=\"csv\" rows=\"4\" placeholder=\"ticker,year,eps_low,eps_mid,eps_high,analysts_count,update_date,source,source_url,estimate_type\"></textarea></label><label><input name=\"verified\" type=\"checkbox\" required> 我已核對來源、使用權限、幣別／單位及股票代碼</label><div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button type=\"submit\">匯入並檢查</button><button id=\"exportEstimates\" type=\"button\">下載備份 CSV</button></div></form><p id=\"estimateSummary\" class=\"tiny\">尚無匯入紀錄。</p><div id=\"estimateRows\"></div></details><div style=\"margin-top:12px;padding-top:10px;border-top:1px solid #314156\"><strong>資料池同步狀態</strong><p class=\"tiny\">雲端候選資料自動載入並保留來源；未核實候選不寫入正式共識或 Gate。</p><label>選取 JSON 資料包<input id=\"shadowPackageFile\" type=\"file\" accept=\"application/json\"></label><button id=\"retryShadowCloud\" type=\"button\">重新同步雲端資料</button><p id=\"shadowPackageSummary\" class=\"tiny\">資料池載入中。</p><div id=\"shadowPackageRows\"></div></div><div style=\"margin-top:12px\"><strong>直接同業池</strong><p class=\"tiny\" id=\"peerUniverseSummary\">同業 Forward P/E 只用相同年度有效共識及行情計算；個股模型 EPS 不當成市場共識。</p><button id=\"loadCuratedPeers\" type=\"button\">載入直接同業資料</button><div id=\"peerUniverseRows\" class=\"tiny\"></div></div></details>\n    <details class=\"panel\" style=\"margin:12px 0;padding:14px\"><summary><strong>Gate 5B｜自動連結 EPS 實際值與市場共識候選</strong></summary><div id=\"autoSurpriseLink\" class=\"tiny\" aria-live=\"polite\">選取個股後自動比對資料池與已讀取季度 EPS。</div><details style=\"margin-top:12px\"><summary><strong>人工補登財報前共識（只補資料池缺項）</strong></summary><p class=\"tiny\">共識原發布日與原始保存時間戳均須早於財報公布；CSV 須附 currency、unit、accounting_basis、consensus_captured_at（含時區），同日公告另附 earnings_at。事後下載不回填為財報前快照；年度 EPS 或公司內部模型不能替代市場季度共識。8 個不同季度才達樣本門檻，候選紀錄不會自動通過 Gate。</p><form id=\"surpriseImportForm\" style=\"display:grid;gap:8px;margin:10px 0\"><label>貼上 CSV 資料<textarea name=\"csv\" rows=\"4\" placeholder=\"ticker,period,consensus_eps,consensus_asof,actual_eps,earnings_date,consensus_source,consensus_url,actual_source,actual_url,currency,unit,accounting_basis,consensus_captured_at,earnings_at\"></textarea></label><label><input name=\"verified\" type=\"checkbox\" required> 我已核對共識在財報前發布、實際 EPS 期別與來源授權</label><div style=\"display:flex;gap:8px;flex-wrap:wrap\"><button type=\"submit\">匯入並檢查</button><button id=\"exportSurprises\" type=\"button\">下載備份 CSV</button></div></form><p id=\"surpriseSummary\" class=\"tiny\">尚無 EPS surprise 匯入資料。</p><div id=\"surpriseRows\"></div></details></details>\n    <details class=\"panel\" style=\"margin:12px 0;padding:14px\"><summary><strong>Gate 5A｜自動連結資料池的公司指引紀錄</strong></summary><div id=\"autoGuidanceLink\" class=\"tiny\" aria-live=\"polite\">選取個股後自動載入指引候選、財報實際值與總經快照。</div><details style=\"margin-top:12px\"><summary><strong>人工補登官方指引（只補資料池缺項）</strong></summary><p class=\"tiny\">資料池中的指引候選會先自動顯示；仍須回到公司公告／法說簡報核對，未核對候選不列入回測。少於 4 季僅觀察；同一指標 8 個不同期別且實績來源核對後才達樣本門檻。</p><form id=\"guidanceForm\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;margin:10px 0\"><label>公告日<input name=\"date\" type=\"date\" required></label><label>預測期別<input name=\"period\" placeholder=\"2026 Q4\" required></label><label>指標<input name=\"metric\" placeholder=\"營收／毛利率／EPS\" required></label><label>指引下限<input name=\"low\" type=\"number\" step=\"any\" required></label><label>指引上限<input name=\"high\" type=\"number\" step=\"any\" required></label><label>實際結果<input name=\"actual\" type=\"number\" step=\"any\" placeholder=\"未公布可留空\"></label><label>單位<input name=\"unit\" placeholder=\"billion TWD／percent\" required></label><label>幣別<input name=\"currency\" placeholder=\"TWD；實物數量留空\"></label><label>會計／統計口徑<input name=\"accounting_basis\" placeholder=\"TIFRS／實物出貨量\" required></label><label>實績公告日<input name=\"actual_date\" type=\"date\"></label><label>實績官方來源<input name=\"actual_source\" type=\"url\" placeholder=\"已公布實績的原文網址\"></label><label style=\"grid-column:1/-1\">公司官方來源網址<input name=\"source\" type=\"url\" placeholder=\"MOPS／公司 IR／官方簡報網址\" required></label><label style=\"grid-column:1/-1\">助理判讀摘要（不取代原文）<textarea name=\"assistantJudgment\" rows=\"3\" placeholder=\"資料池候選摘要與待核重點\"></textarea></label><label style=\"grid-column:1/-1\"><input name=\"sourceVerified\" type=\"checkbox\" required> 我已對照公司官方原始資料，確認標的、期別、數值與來源一致</label><button type=\"submit\">儲存指引與判讀</button></form><p id=\"guidanceSummary\" class=\"tiny\">尚無已記錄指引；新增後顯示分指標樣本數、區間命中率及來源。</p><div id=\"guidanceLog\"></div></details></details>\n    <div class=\"gate-list\" id=\"gateList\"></div>\n    <section class=\"advisory-panels\" id=\"advisoryPanels\" aria-live=\"polite\" hidden></section>\n    <div class=\"sector-chain\" id=\"sectorChain\"></div>\n    <div class=\"four\" id=\"fourQuadrants\"></div>\n    <p class=\"tiny\">評分規則：10D／Veto 與三層漏斗 40／30／30 僅在獨立來源與可核對證據齊備後計分；缺值不當 0 分、不視為通過。一票否決需有可核實紅線證據。</p>\n    <div class=\"overall-report\" id=\"overallReport\" aria-live=\"polite\">\n      <div class=\"overall-report-head\"><h4 id=\"overallReportTitle\">整體檢驗報告</h4><span class=\"badge muted-status\" id=\"overallReportStatus\">等待個股資料</span></div>\n      <p id=\"overallReportSummary\">資料載入後，這裡會彙整已核實證據、機會、風險與模型結論。</p>\n      <section style=\"margin:10px 0;padding:12px;border:1px solid #29425c;border-radius:12px\"><b>財報資料輸入來源</b><p id=\"financialMacroIntegration\" class=\"tiny\">等待個股財報快照。</p></section>\n      <div class=\"overall-report-grid\">\n        <section><b>已核實證據</b><p id=\"overallReportEvidence\">等待資料</p></section>\n        <section><b>機會訊號</b><p id=\"overallReportOpportunity\">等待資料</p></section>\n        <section><b>風險與缺項</b><p id=\"overallReportRisks\">等待資料</p></section>\n        <section><b>法說助理判讀</b><p id=\"overallReportGuidance\">尚無已記錄的法說判讀；需引用公司原始公告或簡報。</p></section>\n      </div>\n      <p class=\"overall-report-next\" id=\"overallReportNext\">模型結論：等待資料</p>\n    </div>\n  </section>\n  <details class=\"macro-info\" id=\"clientDiagnostics\" data-client-version=\"212\">\n    <summary>頁面狀態與載入診斷｜212</summary>\n    <p id=\"clientDiagnosticsSummary\" role=\"status\" aria-live=\"polite\">正在記錄此頁面的載入狀態。</p>\n    <div id=\"clientDiagnosticsEvents\" class=\"tiny\"></div>\n    <p id=\"clientDiagnosticsSync\" class=\"tiny\">只記錄裝置類型、視窗尺寸、耗時與錯誤類別；不含研究內容或登入資料。</p>\n    <button class=\"refresh\" id=\"reloadDashboard\" type=\"button\">重新載入頁面</button>\n  </details>\n</main>\n<script>\n/* FALLBACK_ENGINE_START */\n// User-directed fallback policy, separate from the unrecovered original 10D\n// rubric. Grades are policy risk categories, not an audited 0–100 total.\nfunction computeFallbackRating(input) {\n  const order=['D','C','B','B+','A'],reasons=[],adjustments=[];\n  const cap=(grade,ceiling)=>order[Math.min(order.indexOf(grade),order.indexOf(ceiling))];\n  if(input.vetoStatus==='triggered')return {available:true,status:'vetoed',grade:'VETO',label:'否決／剔除',score:0,forecastFactor:0,forecastReferenceWeight:0,basis:'已核實否決優先，其他分級條件不能覆蓋。',policyVersion:'user-fallback-210',reasons:['已核實否決紅線優先，退避規則不能解除。'],adjustments:[],riskPermission:'vetoed'};\n  const validDate=value=>/^\\d{4}-\\d{2}-\\d{2}$/.test(String(value||''))&&Number.isFinite(Date.parse(value))&&new Date(value).toISOString().slice(0,10)===value;\n  const today=new Date(Date.now()+8*3600000).toISOString().slice(0,10);\n  const values=(input.scenarios||[]).map(row=>row.value),valid=values.length===3&&values.every(Number.isFinite)&&values[0]>0&&values[0]<=values[1]&&values[1]<=values[2]&&validDate(input.priceDate)&&input.priceDate<=today;\n  if(!input.stockFresh||!Number.isFinite(input.price)||input.price<=0||!valid)return {available:false,status:'data_unavailable',grade:null,score:null,policyVersion:'user-fallback-210',reasons:['缺有效日期的行情或可驗證估值；已取得資料仍可顯示，不能生成當前價格評級。'],adjustments:[],riskPermission:'not_cleared'};\n  let grade=input.price<=values[0]?'A':input.price<=values[1]?'B+':input.price<=values[2]?'B':'C';\n  const valuationGrade=grade;\n  reasons.push(`現價 ${input.price.toFixed(2)} 元，依已核驗 Bear／Base／Bull ${values.map(x=>x.toFixed(2)).join('／')} 元作自身估值對照：${grade}。`);\n  if(!input.scoringReady)adjustments.push({gate:4,rule:'neutral',weight:0,detail:'10D／短期籌碼原始分級未齊，貢獻權重為0，不扣分也不加分；否決紅線獨立保留。'});\n  const guidanceMissing=!input.guidanceReady||!input.surprisesReady;\n  const forecastFactor=guidanceMissing ? 0.85 : 1;\n  if(guidanceMissing){grade=cap(grade,'B+');adjustments.push({gate:5,rule:'zero_guidance_weight_and_grade_cap',weight:0,ceiling:'B+',forecastFactor,detail:'指引／季度回測不足：指引權重0，評級最高B+；共識預測參考權重乘0.85（15%政策折減，不是準確率）。'});}\n  const historical=input.history;\n  const historicalReady=historical&&Number.isInteger(historical.observations)&&historical.observations>=250&&[historical.p20,historical.median,historical.p80].every(Number.isFinite)&&historical.p20>0&&historical.p20<=historical.median&&historical.median<=historical.p80&&validDate(historical.from)&&historical.from<=historical.through&&historical.through===input.priceDate;\n  if(!input.peerReady||!input.nextConsensusReady)adjustments.push({gate:8,rule:historicalReady?'self_historical_pe':'existing_verified_valuation',weight:0,detail:historicalReady?`共識／直接同業不足，採自身歷史 P/E P20／中位／P80 ${historical.p20.toFixed(2)}／${historical.median.toFixed(2)}／${historical.p80.toFixed(2)}x；${historical.observations}筆，${historical.from}–${historical.through}。`: '共識／同業不足，沿用已核驗的個股估值情境；未取得的 P/B 或次產業中位數不補造。'});\n  if(input.qualityWarning){const before=grade;grade=order[Math.max(0,order.indexOf(grade)-1)];reasons.push(`現金流／財報品質警訊使風險評級下調一級：${before} → ${grade}；CFO 與 FCF 同源警訊不重複扣減。`);adjustments.push({gate:6,rule:'one_grade_risk_deduction',grades:-1,detail:'實質風險列入評級與警告，持續產出；不解除原始否決。'});}\n  if(input.vetoStatus!=='clear'){grade=cap(grade,'B');reasons.push('部分否決條件尚未排除：保留風險限制，退避評級最高B。');}\n  if(!input.coreReady||!input.qualityReady){grade=cap(grade,'C');reasons.push('總經／市場或必要財報欄位尚未齊：仍輸出已有資料的風險觀察，評級最高C。');}\n  if(input.timingWeak){const before=grade;grade=order[Math.max(0,order.indexOf(grade)-1)];reasons.push(`價格低於 MA20 與 MA60，時機風險下調一級：${before} → ${grade}。`);}\n  return {available:true,status:'degraded',grade,label:grade==='D'?'風險偏高':grade==='C'?'保守觀察':grade==='B'?'附限制觀察':grade==='B+'?'估值具條件吸引力':'條件較有利',score:null,\n    policyVersion:'user-fallback-210',policyLabel:'自訂退避風險評級',isOriginalMasterScore:false,valuationGrade,forecastFactor,forecastReferenceWeight:input.currentConsensusReady?forecastFactor:0,consensusUsage:'reference_only',forecastCoefficientApplied:false,\n    reasons,adjustments,riskPermission:input.vetoStatus==='clear'&&input.coreReady&&input.qualityReady&&!input.qualityWarning?'subject_to_macro_budget':'not_cleared',\n    basis:'先按現價與自身三情境對照分級，再套用資料上限、品質與時機扣減；不是阮慕驊原始10D總分。'};\n}\n\n/* FALLBACK_ENGINE_END */\nconst siteNativeFetch=fetch;\nconst clientDiagnosticState={version:'212',events:[],revision:0,sentRevision:0,lastSync:0,syncing:false,timer:null,longTaskSupported:false};\nconst requestBreakers=new Map(),requestInFlight=new Map(),MAX_AUTO_RETRIES=3;\nfunction resetRequestBreakers(){requestBreakers.clear()}\nfunction isCompactDevice(){return window.innerWidth>0&&window.innerWidth<=700||['iOS','Android'].includes(diagnosticDevice())}\nfunction currentBackendModel(data){const model=data?.masterModel;return data?.id&&!data.snapshotStale&&model?.symbol===data.id&&model?.stockCheckedAt===data.checkedAt&&(model.stockPriceDate==null||model.stockPriceDate===data.price?.date&&model.stockPriceValue===data.price?.value)?model:null}\nfunction mountLazyDetails(node,renderContent){\n node.lazyContentRenderer=renderContent;\n const load=()=>{if(node.dataset.loaded)return;node.dataset.loaded='true';node.lazyContentRenderer()};\n if(!node.dataset.lazyBound){node.dataset.lazyBound='true';node.addEventListener('toggle',()=>{if(node.open)load()});}\n if(!isCompactDevice()||node.open)load();return node;\n}\nfunction appendBoundedRows(host,rows,makeNode){\n let offset=0;const count=isCompactDevice()?20:rows.length;\n const more=()=>{for(const row of rows.slice(offset,offset+count)){const node=makeNode(row);if(node)host.append(node)}offset+=count;if(offset<rows.length){const button=document.createElement('button');button.type='button';button.className='refresh';button.textContent=`查看更多（尚有 ${rows.length-offset} 筆）`;button.addEventListener('click',()=>{button.remove();more()});host.append(button)}};more();\n}\nfunction deferCompactSection(host,renderContent){\n const details=host?.closest?.('details');\n if(!isCompactDevice()||!details||details.open){if(host)host.pendingRenderer=null;renderContent();return}\n host.pendingRenderer=renderContent;\n if(!host.dataset.lazyBound){host.dataset.lazyBound='true';details.addEventListener('toggle',()=>{if(details.open&&host.pendingRenderer){const render=host.pendingRenderer;host.pendingRenderer=null;render()}})}\n}\nfunction renderMacroIndicatorDetails(rows,unavailable=[]){\n const host=document.getElementById('macroIndicators');if(!host)return;\n deferCompactSection(host,()=>{host.replaceChildren();appendBoundedRows(host,rows,macroIndicatorCard);appendUnavailable(host,unavailable)});\n}\nfunction diagnosticNow(){return typeof performance!=='undefined'&&typeof performance.now==='function'?performance.now():Date.now()}\nfunction diagnosticDevice(){const ua=window.navigator?.userAgent||'';return /iPhone|iPad|iPod/.test(ua)||/Macintosh/.test(ua)&&window.navigator?.maxTouchPoints>1?'iOS':/Android/.test(ua)?'Android':'Other'}\nfunction renderClientDiagnostics(){\n const state=clientDiagnosticState,summary=document.getElementById('clientDiagnosticsSummary'),host=document.getElementById('clientDiagnosticsEvents');if(!summary||!host)return;\n const apis=state.events.filter(row=>row.kind==='api'),renders=state.events.filter(row=>row.kind==='render'),errors=state.events.filter(row=>['error'].includes(row.kind)||row.kind==='api'&&row.outcome!=='ok');\n summary.textContent=`${diagnosticDevice()}｜資料請求 ${apis.length} 次｜錯誤 ${errors.length} 次｜最久請求 ${apis.length?(Math.max(...apis.map(row=>row.ms))/1000).toFixed(1):'—'} 秒｜最久畫面重繪 ${renders.length?Math.max(...renders.map(row=>row.ms)):'—'} 毫秒。${state.longTaskSupported?'已啟用長任務觀測。':'此瀏覽器未提供長任務觀測；仍記錄重繪耗時，不能據此判定無卡頓。'}`;\n const names={ok:'完成