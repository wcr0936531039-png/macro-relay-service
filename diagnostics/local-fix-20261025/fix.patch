+function fixture(){
+ const base='https://www.twse.com.tw/rwd/zh/marginTrading/';
+ return {date:'2026-10-22',capturedAt:capture,calendar,tradingDates:[{Date:'1151021',TradeValue:'874614166736'},{Date:'1151022',TradeValue:'933437473560'}],sourceUrls:{calendar:'https://www.twse.com.tw/holidaySchedule/holidaySchedule?response=json',tradingDates:'https://openapi.twse.com.tw/v1/exchangeReport/FMTQIK',margin:base+'MI_MARGN?response=json&date=20261022&selectType=MS',marginTrend:base+'MI_MARGN_TREND?response=json&date=20261022&days=30',creditSummary:base+'BFIJ3U?response=json&date=20261022'},margin:{stat:'OK',date:'20261022',tables:[{fields:['項目','買進','賣出','現金(券)償還','前日餘額','今日餘額'],data:[['融資(交易單位)',0,0,0,9632327,9604402],['融券(交易單位)',0,0,0,192598,216539],['融資金額(仟元)',0,0,0,644373624,633880174]]}]},marginTrend:{stat:'OK',date:'20261022',data:[{date:'20261022',marginAmt:633880174,marginShr:9604402,shortShr:216539,marketValue:1507153.73}]},creditSummary:{stat:'OK',date:'20261022',crdAmt:111074731110}};
+}
+test('actual official session survives an unplanned closure with auditable calendar discrepancy',()=>{
+ const rows=api.validateTaiwanStatistics(fixture(),now),row=rows.find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+ assert.equal(row.date,'2026-10-22');assert.equal(row.value,6338.80174);
+ assert.equal(row.sessionVerification.latestSession,'2026-10-22');
+ assert.equal(row.sessionVerification.expectedSession,'2026-10-23');
+ assert.equal(row.sessionVerification.calendarDiscrepancy,true);
+ assert.equal(row.sessionVerification.basis,'official_actual_sessions');
+ assert.equal(row.verifiedAt,capture);
+});
+test('official monthly FMTQIK also determines the actual latest day',()=>{
+ const item=fixture();item.sourceUrls.tradingDates='https://www.twse.com.tw/exchangeReport/FMTQIK?date=20261001&response=json';
+ item.tradingDates={stat:'OK',date:'20261001',fields:['日期','成交股數','成交金額'],data:[['115/10/22','1','933,437,473,560']]};
+ assert.equal(api.validateTaiwanStatistics(item,now)[0].date,'2026-10-22');
+});
+test('planned 10/26 closure is retained while 10/27 becomes the next expected session',()=>{
+ assert.equal(api.expectedTaiwanSession(calendar,Date.parse('2026-10-26T15:00:00Z')),'2026-10-23');
+ assert.equal(api.expectedTaiwanSession(calendar,Date.parse('2026-10-27T15:00:00Z')),'2026-10-27');
+ const item=fixture();item.capturedAt='2026-10-26T15:00:00Z';
+ assert.equal(api.validateTaiwanStatistics(item,Date.parse(item.capturedAt))[0].date,'2026-10-22');
+});
+test('older-than-official, future, invalid-source and expired captures remain rejected',()=>{
+ const newer=fixture();newer.tradingDates.push({Date:'1151023',TradeValue:1});
+ assert.throws(()=>api.validateTaiwanStatistics(newer,now),/not_latest/);
+ const future=fixture();future.tradingDates.push({Date:'1151027',TradeValue:1});
+ assert.throws(()=>api.validateTaiwanStatistics(future,now),/not_latest/);
+ const old=fixture();old.capturedAt='2026-10-20T00:00:00Z';assert.throws(()=>api.validateTaiwanStatistics(old,now),/capture/);
