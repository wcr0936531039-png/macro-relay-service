+ assert.equal(api.mergeVerifiedMacroRows([{...row,verifiedAt:null,fetchedAt:null}],[])[0].verifiedAt,null);
+});
+test('a cache timestamp alone cannot qualify retained credit as source verification',async()=>{
+ const payload={checkedAt:capture,rows:[{id:'TWSE_MARGIN_BALANCE_NTD',value:6338,date:'2026-10-22',status:'ok',source:'https://www.twse.com.tw/credit'}]};
+ const db={prepare(){return {run:async()=>({success:true}),bind(key){return {all:async()=>({results:key==='macro-market:v7'?[{payload:JSON.stringify(payload),updated_at:capture,expires_at:'2026-11-01T00:00:00Z'}]:[]})}}}}};
+ const result=await api.retainedTaiwanCreditRows({DB:db},now);
+ assert.equal(result.find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD').status,'missing');
+});
+test('module usability excludes stale flags and null values even with status ok',()=>{
+ const r=api.summarizeSiteModule('expandedMacro',{rows:[{id:'A',value:1,status:'ok'},{id:'B',value:2,status:'ok',is_stale:true},{id:'C',value:null,status:'ok'}]});
+ assert.equal(r.usable,1);assert.equal(r.total,3);assert.equal(r.status,'partial');
+});
+test('expired response cache keeps valid monthly observations and retains real source failures',async()=>{
+ const realNow=Date.now;Date.now=()=>now;
+ try{
+  const mod=await import('data:text/javascript;base64,'+Buffer.from(source+'\nbuildExpandedMacroSnapshot=async()=>new Promise(()=>{});').toString('base64'));
+  const payload={checkedAt:capture,rows:[{id:'PAYEMS',date:'2026-09-01',value:159044,status:'ok'},
+   {id:'TW_EXPORT_ORDERS',date:'2026-09-01',value:1,status:'stale',is_stale:true,reason:'HTTP 403'}]};
+  const db={prepare(){return {run:async()=>({success:true}),bind(){return {all:async()=>({results:[{payload:JSON.stringify(payload),updated_at:capture,expires_at:capture}]})}}}}};
+  const result=await(await mod.default.fetch(new Request('https://site.test/api/macro-expanded'),{DB:db},{})).json();
+  assert.equal(result.refreshing,true);assert.equal(result.rows[0].status,'ok');
+  assert.equal(result.rows[1].status,'stale');assert.equal(result.rows[1].reason,'HTTP 403');
+  assert.equal(result.checkedAt,capture);
+ }finally{Date.now=realNow;}
+});
+export {fixture};
