+  for(const changed of [{value:1},{date:'2026-04-01'},{source:'https://example.com/DRTSCILM'},{source:'https://fred.stlouisfed.org/graph/fredgraph.csv?id=OTHER'}])assert.equal(api.sloosReleaseWindow({...row,...changed}),null);
+});
+test('publication evidence does not refresh an old retrieval timestamp',()=>{
+  Date.now=()=>now;
+  const old={...row,fetchedAt:'2026-10-27T03:00:00Z'};
