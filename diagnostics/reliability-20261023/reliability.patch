diff --git a/tests/helpers/refresh-lease.mjs b/tests/helpers/refresh-lease.mjs
new file mode 100644
index 0000000..34d391c
--- /dev/null
+++ b/tests/helpers/refresh-lease.mjs
@@ -0,0 +1,17 @@
+// D1 lease fixture with atomic conflict/expiry semantics for local tests.
+export function refreshLeaseStatement(db,sql){
+ if(!sql.includes('site_refresh_leases'))return null;
+ db.leases??=new Map();
+ return {run:async()=>({success:true}),bind:(...args)=>({
+  run:async()=>{
+   if(sql.startsWith('INSERT')){
+    const [id,token,expires,now]=args,old=db.leases.get(id);
+    if(old&&old.expires_at>now)return {success:true,meta:{changes:0}};
+    db.leases.set(id,{token,expires_at:expires});return {success:true,meta:{changes:1}};
+   }
+   if(sql.startsWith('DELETE')){if(db.leases.get(args[0])?.token===args[1])db.leases.delete(args[0]);return {success:true,meta:{changes:1}};}
+   return {success:true,meta:{changes:0}};
+  },
+  all:async()=>({results:db.leases.has(args[0])?[db.leases.get(args[0])]:[]})
+ })};
+}
