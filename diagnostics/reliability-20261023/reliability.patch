--- /dev/null
+++ b/tests/credit-capture-window.test.mjs
@@ -0,0 +1,137 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const source=fs.readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const stockApi=await import('data:text/javascript;base64,'+Buffer.from(source+'\nexport {loadStockCreditDataset};').toString('base64'));
+const ids=['TWSE_MARGIN_BALANCE_NTD','TWSE_MARGIN_CHANGE_NTD','TWSE_MARGIN_BALANCE_UNITS','TWSE_SHORT_BALANCE','TWSE_SHORT_CHANGE','TWSE_MARGIN_MARKET_CAP_RATIO','TWSE_CREDIT_TRADE_VALUE'];
+const savedAt='2026-10-21T15:00:00Z';
+const savedRows=()=>ids.map((id,index)=>({id,name:id,unit:'test',value:index-2,date:'2026-10-21',status:'ok',is_stale:false,verifiedAt:savedAt,fetchedAt:savedAt,source:'https://www.twse.com.tw/rwd/zh/marginTrading/MI_MARGN?response=json&date=20261021&selectType=MS'}));
+function dbWith(rows,checkedAt=savedAt){
+ const data=new Map(rows?[['macro-market:v7',{payload:JSON.stringify({checkedAt,rows}),updated_at:checkedAt,expires_at:'2026-10-23T00:00:00Z'}]]:[]);
+ return {prepare(sql){return {run:async()=>({success:true}),bind(key){return {all:async()=>({results:data.has(key)?[data.get(key)]:[]}),run:async()=>({success:true})}}}}};
+}
+function upstream(calls){return async input=>{
+ const url=new URL(input);calls.push(url.href);
+ if(url.pathname.endsWith('/FMTQIK'))return Response.json([{Date:'1151021',TradeValue:'900000000000'}]);
+ if(url.pathname.endsWith('/MI_MARGN'))return Response.json({stat:'OK',date:'20261021',tables:[{fields:['項目','買進','賣出','償還','前日餘額','今日餘額'],data:[['融資(交易單位)',0,0,0,100,110],['融券(交易單位)',0,0,0,200,210],['融資金額(仟元)',0,0,0,300000000,310000000]]}]});
+ if(url.pathname.endsWith('/MI_MARGN_TREND'))return Response.json({stat:'OK',date:'20261021',data:[{date:'20261021',marginAmt:310000000,marketValue:1000000}]});
+ if(url.pathname.endsWith('/BFIJ3U'))return Response.json({stat:'OK',date:'20261021',crdAmt:12000000000});
+ throw Error('Unexpected test request: '+url.pathname);
+};}
+async function runAt(time,rows){
+ const oldNow=Date.now,oldFetch=globalThis.fetch,calls=[];
+ Date.now=()=>Date.parse(time);globalThis.fetch=upstream(calls);
+ try{
+  const api=await import('data:text/javascript;base64,'+Buffer.from(source+`\nrelaySeries=async()=>null;\nexport {loadTaiwanDashboard,mergeVerifiedMacroRows};\n// window-test-${Math.random()}`).toString('base64'));
+  const result=await api.loadTaiwanDashboard({DB:dbWith(rows)});
+  return {result,calls,merged:api.mergeVerifiedMacroRows(result,[])};
+ }finally{Date.now=oldNow;globalThis.fetch=oldFetch;}
+}
+const creditCalls=calls=>calls.filter(url=>/MI_MARGN|BFIJ3U/.test(url));
+
+test('morning retains verified credit values and original timestamps without any credit request',async()=>{
+ const original=savedRows(),{result,calls,merged}=await runAt('2026-10-22T02:14:00Z',original);
+ assert.deepEqual(creditCalls(calls),[]);
+ for(const row of original){const actual=result.find(x=>x.id===row.id);assert.equal(actual.value,row.value);assert.equal(actual.date,row.date);assert.equal(actual.verifiedAt,savedAt);assert.equal(actual.fetchedAt,savedAt);assert.equal(actual.captureDeferred,true);assert.equal(merged.find(x=>x.id===row.id).verifiedAt,savedAt);}
+ assert.equal(result.find(x=>x.id==='TWSE_TOTAL_TRADE_VALUE').value,9000,'normal market turnover can still update');
+});
+test('morning without retained credit keeps every credit field missing instead of fetching or inventing values',async()=>{
+ const {result,calls}=await runAt('2026-10-22T02:14:00Z',null);
+ assert.deepEqual(creditCalls(calls),[]);
+ for(const id of ids){const row=result.find(x=>x.id===id);assert.ok(row,id);assert.equal(row.value,null);assert.equal(row.status,'missing');assert.equal(row.captureDeferred,true);}
+});
+test('expired retained credit remains dated and stale; refresh cannot renew its clock',async()=>{
+ const rows=savedRows().map(row=>({...row,verifiedAt:'2026-10-19T15:00:00Z',fetchedAt:'2026-10-19T15:00:00Z'}));
+ const {result,calls,merged}=await runAt('2026-10-22T02:14:00Z',rows);
+ assert.deepEqual(creditCalls(calls),[]);
+ for(const id of ids){const row=result.find(x=>x.id===id);assert.equal(row.status,'stale');assert.equal(row.is_stale,true);assert.equal(row.verifiedAt,'2026-10-19T15:00:00Z');assert.equal(merged.find(x=>x.id===id).verifiedAt,row.verifiedAt);}
+});
+test('22:29 Taipei remains closed, 22:30 permits the existing official credit route',async()=>{
+ const before=await runAt('2026-10-22T14:29:59Z',savedRows());assert.deepEqual(creditCalls(before.calls),[]);
+ const after=await runAt('2026-10-22T14:30:00Z',savedRows());assert.ok(creditCalls(after.calls).length>=3);assert.equal(after.result.find(x=>x.id==='TWSE_MARGIN_BALANCE_NTD').value,3100);
+});
+test('midnight closes the window again and unverified or future evidence cannot become retained valid data',async()=>{
+ const rows=savedRows().map((row,index)=>index%2?{...row,status:'unverified'}:{...row,verifiedAt:'2026-10-23T15:00:00Z'});
+ const {result,calls}=await runAt('2026-10-22T16:00:00Z',rows);assert.deepEqual(creditCalls(calls),[]);
+ assert.ok(ids.every(id=>result.find(row=>row.id===id)?.status==='missing'));
+});
+test('a source-marked stale row is not promoted by a recent capture time',async()=>{
+ const {result,calls}=await runAt('2026-10-22T02:14:00Z',savedRows().map(row=>({...row,status:'stale',is_stale:true,reason:'source verification failed'})));
+ assert.deepEqual(creditCalls(calls),[]);assert.ok(ids.every(id=>result.find(row=>row.id===id)?.status==='stale'));
+});
+test('invalid source provenance and future observation dates stay missing',async()=>{
+ const {result,calls}=await runAt('2026-10-22T02:14:00Z',savedRows().map((row,index)=>index%2?{...row,date:'2026-10-23'}:{...row,source:'http://www.twse.com.tw/credit'}));
+ assert.deepEqual(creditCalls(calls),[]);assert.ok(ids.every(id=>result.find(row=>row.id===id)?.status==='missing'));
+});
+function stockDb(seed){
+ const data=new Map(seed?[['stock-credit:v1:8299',{payload:JSON.stringify(seed),updated_at:seed.capturedAt,expires_at:'2026-11-01T00:00:00Z'}]]:[]);
+ return {
+  prepare(sql){
+   return {
+    run:async()=>({success:true}),
+    bind(...args){
+     return {
+      all:async()=>({results:data.has(args[0])?[data.get(args[0])]:[]}),
+      run:async()=>{
+       if(sql.includes('INSERT'))data.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});
+       return {success:true};
+      }
+     };
+    }
+   };
+  }
+ };
+}
+const stockCapture=()=>({symbol:'8299',dataset:'TaiwanStockMarginPurchaseShortSale',source:'https://api.finmindtrade.com/api/v4/data?dataset=TaiwanStockMarginPurchaseShortSale',capturedAt:savedAt,rows:[{stock_id:'8299',date:'2026-10-21',MarginPurchaseTodayBalance:110,MarginPurchaseYesterdayBalance:100,ShortSaleTodayBalance:210}]});
+test('individual stock credit does not call FinMind before 22:30 and keeps the actual credit date/capture',async()=>{
+ let calls=0;const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb(stockCapture())},async()=>{calls++;throw Error('must not fetch');},Date.parse('2026-10-22T02:14:00Z'));
+ assert.equal(calls,0);assert.equal(result.status,'snapshot');assert.equal(result.capturedAt,savedAt);assert.equal(result.rows[0].date,'2026-10-21');assert.equal(result.captureDeferred,true);
+});
+test('individual stock credit without a stored snapshot remains deferred/missing',async()=>{
+ let calls=0;const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb()},async()=>{calls++;return {rows:[]};},Date.parse('2026-10-22T02:14:00Z'));
+ assert.equal(calls,0);assert.equal(result.status,'deferred');assert.equal(result.capturedAt,null);assert.deepEqual(result.rows,[]);
+});
+test('individual stock credit allows 22:30 collection and can read that durable snapshot the next morning',async()=>{
+ const env={DB:stockDb()};let calls=0;
+ const evening=await stockApi.loadStockCreditDataset('8299',env,async()=>{calls++;return {rows:stockCapture().rows,error:null};},Date.parse('2026-10-22T14:30:00Z'));
+ assert.equal(evening.status,'ok');assert.equal(evening.recorded,true);assert.equal(calls,1);
+ const morning=await stockApi.loadStockCreditDataset('8299',env,async()=>{calls++;throw Error('must not fetch');},Date.parse('2026-10-23T02:14:00Z'));
+ assert.equal(calls,1);assert.equal(morning.status,'snapshot');assert.equal(morning.capturedAt,'2026-10-22T14:30:00.000Z');assert.equal(morning.rows[0].date,'2026-10-21');
+});
+test('individual stock credit keeps expired evidence stale and rejects mismatched or future cache contents',async()=>{
+ const old={...stockCapture(),capturedAt:'2026-10-19T15:00:00Z',rows:[{...stockCapture().rows[0],date:'2026-10-19'}]};
+ const fetch=async()=>{throw Error('must not fetch');};
+ assert.equal((await stockApi.loadStockCreditDataset('8299',{DB:stockDb(old)},fetch,Date.parse('2026-10-22T02:14:00Z'))).status,'stale');
+ for(const bad of [{...stockCapture(),symbol:'5289'},{...stockCapture(),capturedAt:'2026-10-23T15:00:00Z'},{...stockCapture(),rows:[{...stockCapture().rows[0],date:'2026-10-23'}]}])assert.equal((await stockApi.loadStockCreditDataset('8299',{DB:stockDb(bad)},fetch,Date.parse('2026-10-22T02:14:00Z'))).status,'deferred');
+});
+test('a recent retrieval cannot renew an old stock credit observation',async()=>{
+ const seed={...stockCapture(),rows:[{...stockCapture().rows[0],date:'2020-01-02'}]};
+ const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb(seed)},async()=>{throw Error('must not fetch');},Date.parse('2026-10-22T02:14:00Z'));
+ assert.equal(result.status,'stale');assert.equal(result.is_stale,true);assert.equal(result.rows[0].date,'2020-01-02');assert.equal(result.capturedAt,savedAt);
+});
+test('an evening retrieval of old observations remains stale instead of ok',async()=>{
+ const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb()},async()=>({rows:[{...stockCapture().rows[0],date:'2020-01-02'}]}),Date.parse('2026-10-22T14:30:00Z'));
+ assert.equal(result.status,'stale');assert.equal(result.is_stale,true);assert.equal(result.recorded,true);
+});
+test('stock credit rejects missing, empty, negative, fractional, nonfinite and boolean balances',async()=>{
+ for(const field of ['MarginPurchaseTodayBalance','MarginPurchaseYesterdayBalance','ShortSaleTodayBalance'])for(const value of [undefined,null,'',' ',NaN,Infinity,-1,1.5,true,'invalid']){
+  const seed={...stockCapture(),rows:[{...stockCapture().rows[0],[field]:value}]};
+  const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb(seed)},async()=>{throw Error('must not fetch');},Date.parse('2026-10-22T02:14:00Z'));
+  assert.equal(result.status,'deferred',`${field}=${String(value)}`);assert.deepEqual(result.rows,[]);
+ }
+});
+test('evening invalid balances are rejected before persistence while real zero is accepted',async()=>{
+ const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb()},async()=>({rows:[{stock_id:'8299',date:'2026-10-22'}]}),Date.parse('2026-10-22T14:30:00Z'));
+ assert.equal(result.status,'error');assert.deepEqual(result.rows,[]);assert.notEqual(result.recorded,true);
+ const valid={...stockCapture().rows[0],MarginPurchaseTodayBalance:'0',MarginPurchaseYesterdayBalance:0,ShortSaleTodayBalance:0};
+ const zero=await stockApi.loadStockCreditDataset('8299',{DB:stockDb()},async()=>({rows:[valid]}),Date.parse('2026-10-22T14:30:00Z'));
+ assert.equal(zero.status,'ok');assert.equal(zero.rows[0].MarginPurchaseTodayBalance,'0');
+});
+test('duplicate credit dates and observations later than their original capture are rejected',async()=>{
+ const row=stockCapture().rows[0];
+ for(const rows of [[row,{...row}],[row,{...row,MarginPurchaseTodayBalance:111}],[{...row,date:'2026-10-22'}]]){
+  const result=await stockApi.loadStockCreditDataset('8299',{DB:stockDb({...stockCapture(),rows})},async()=>{throw Error('must not fetch');},Date.parse('2026-10-22T02:14:00Z'));
+  assert.equal(result.status,'deferred');assert.deepEqual(result.rows,[]);
+ }
+});
